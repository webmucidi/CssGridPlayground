<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Grid Lab</title>
<link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&family=Fira+Code:wght@400;500&display=swap" rel="stylesheet">
<style>
:root{--bg:#F4F6FB;--sf:#fff;--ink:#151B2B;--mute:#5C6780;--line:#DFE4EE;--acc:#3B5BDB;--ok:#12A150;--bad:#E03131;--cd:#EEF1F7;color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0E1320;--sf:#171E30;--ink:#E9EDF6;--mute:#98A3BC;--line:#27304A;--acc:#8FA6FF;--ok:#3DD68C;--bad:#FF6B6B;--cd:#1D2540;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#0E1320;--sf:#171E30;--ink:#E9EDF6;--mute:#98A3BC;--line:#27304A;--acc:#8FA6FF;--ok:#3DD68C;--bad:#FF6B6B;--cd:#1D2540;color-scheme:dark}
*{box-sizing:border-box}[hidden]{display:none!important}
html{height:100dvh}
body{height:100%;margin:0;overflow:hidden;background:var(--bg);color:var(--ink);font:400 14px/1.45 Figtree,system-ui,sans-serif}
#app{height:100%;width:100%;display:grid;grid-template-columns:minmax(0,1fr);grid-template-rows:auto auto minmax(0,1fr) auto minmax(0,36%);grid-template-areas:"h""q""s""t""sh"}
header{grid-area:h;display:flex;justify-content:space-between;align-items:center;padding:8px 12px 4px}
h1{font:700 20px Figtree;margin:0;letter-spacing:-.01em}
button,select{font:600 13px Figtree,sans-serif;color:var(--ink);background:var(--sf);border:1px solid var(--line);border-radius:10px;padding:8px 12px;cursor:pointer;min-height:36px}
button.on{background:var(--acc);border-color:var(--acc);color:var(--bg)}
button.pri{background:var(--ok);border-color:var(--ok);color:#fff}
:focus-visible{outline:3px solid var(--acc);outline-offset:2px}
.seg{display:flex;gap:4px}.seg button{padding:6px 12px}
#qbar{grid-area:q;display:flex;gap:10px;padding:2px 12px 6px;align-items:center}
#qi{flex:1;min-width:0}
#chips{display:flex;gap:5px;margin-bottom:5px}
#chips button{width:34px;padding:0;min-height:30px}#chips .done{border-color:var(--ok)}#chips .done:not(.on){color:var(--ok)}
#prompt{margin:0;font-size:13px;color:var(--mute);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
#thumb{flex:none;width:104px;height:66px}
.mini{display:grid;gap:3px;width:100%;height:100%}
.mini b{display:grid;place-items:center;border-radius:5px;color:#fff;font:600 9px "Fira Code",monospace}
#stage{grid-area:s;padding:6px 12px;display:grid;min-height:0}
#grid{display:grid;gap:8px;touch-action:none;user-select:none;min-height:0;cursor:crosshair}
.c{border:1.5px dashed var(--line);border-radius:8px;background:var(--sf)}
.a{display:grid;place-items:center;border-radius:10px;background:var(--c);color:#fff;font:600 13px "Fira Code",monospace;pointer-events:none}
.a.pop{animation:pop .45s cubic-bezier(.2,1.4,.4,1)}.a.pulse{animation:pulse .6s}.a.bad{animation:shake .5s;outline:3px solid var(--bad)}
#sel{border:2.5px dashed var(--acc);background:color-mix(in srgb,var(--acc) 22%,transparent);border-radius:10px;pointer-events:none}
#sel.eraser{border-color:var(--bad);background:color-mix(in srgb,var(--bad) 22%,transparent)}
@keyframes pop{from{transform:scale(.5);opacity:0}}
@keyframes pulse{40%{transform:scale(1.07);filter:brightness(1.2)}}
@keyframes shake{25%{transform:translateX(-6px)}75%{transform:translateX(6px)}}
@keyframes fade{from{opacity:0;transform:translateY(5px)}}
#fill{align-self:center;min-height:0}
.fc{margin:0;background:var(--sf);border:1px solid var(--line);border-radius:14px;padding:16px;font:500 14px/2.2 "Fira Code",monospace;white-space:pre-wrap;overflow-wrap:anywhere}
.fc select{font:500 13px "Fira Code",monospace;max-width:100%;padding:4px 6px;min-height:30px}
select.ok{border-color:var(--ok);background:color-mix(in srgb,var(--ok) 18%,var(--sf))}select.no{border-color:var(--bad);background:color-mix(in srgb,var(--bad) 18%,var(--sf))}
.ans{background:color-mix(in srgb,var(--ok) 20%,transparent);color:var(--ok);padding:2px 8px;border-radius:6px;font-weight:600;animation:pop .45s cubic-bezier(.2,1.4,.4,1);display:inline-block}
#tools{grid-area:t;padding:4px 12px 8px;display:grid;gap:6px}
.row{display:flex;gap:6px;align-items:center}.row>button,.row>select{flex:1}
.st{display:flex;align-items:center;gap:4px;flex:1.3;font-size:12px;color:var(--mute)}.st button{width:30px;padding:0;min-height:32px}.st b{min-width:14px;text-align:center;color:var(--ink)}
#sheet{grid-area:sh;background:var(--sf);border-top:1px solid var(--line);border-radius:18px 18px 0 0;display:flex;flex-direction:column;min-height:0;padding:10px 12px 8px}
.bar{display:flex;justify-content:space-between;gap:8px;margin-bottom:6px}.bar button{padding:5px 12px;min-height:32px}
#code{margin:0;background:var(--cd);border-radius:10px;padding:8px 12px;font:400 12px/1.6 "Fira Code",monospace;overflow:auto;flex:1 1 40%;min-height:0;white-space:pre}
.l{transition:.35s}.l.h{opacity:0;transform:translateX(-10px)}
.k{color:var(--acc)}.s{color:#e8590c}.v{color:var(--ok)}
#cap{overflow:auto;flex:1 1 30%;min-height:0;padding-top:6px;font-size:13px}
#cap p{margin:0 0 4px;animation:fade .35s}.ex{color:var(--mute)}.good{color:var(--ok);font-weight:700}.no{color:var(--bad);font-weight:700}
@media (min-width:860px){#app{grid-template-columns:minmax(0,1fr) 430px;grid-template-rows:auto auto minmax(0,1fr) auto;grid-template-areas:"h h""q sh""s sh""t sh"}#sheet{border-radius:0;border-top:0;border-left:1px solid var(--line)}}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>
</head>
<body>
<div id="app">
<header><h1>Grid Lab</h1><div class="seg" id="modes"><button data-m="free">Serbest</button><button data-m="quiz">Sorular</button></div></header>
<div id="qbar" hidden><div id="qi"><div id="chips"></div><p id="prompt"></p></div><div id="thumb"></div></div>
<main id="stage"><div id="grid"></div><div id="fill" hidden></div></main>
<div id="tools">
<div class="row" id="t1"><button class="po on" data-t="lasso">Lasso</button><button class="po" data-t="eraser">Silgi</button><button class="po" id="clr">Temizle</button><button id="chk" class="pri" hidden>Kontrol et</button></div>
<div class="row" id="t2"><select id="nm" aria-label="Alan adı"></select><span class="st">Satır <button id="rm">−</button><b id="rv">3</b><button id="rp">+</button></span><span class="st">Sütun <button id="cm">−</button><b id="cv">2</b><button id="cp">+</button></span></div>
</div>
<section id="sheet"><div class="bar"><div class="seg" id="vw"><button data-v="name" class="on">Alan adı</button><button data-v="line">Çizgi no</button></div><button class="po" id="play">▶ Oynat</button></div><pre id="code"></pre><div id="cap"></div></section>
</div>
<script>
const $=s=>document.querySelector(s),PAL=['#e8467c','#3b5bdb','#12a594','#f59f00','#9c36b5','#2f9e44','#e8590c','#1c7ed6'];
const esc=s=>String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;');
const hl=t=>esc(t).replace(/^(\s*)([a-z-]+)(:)/,'$1<span class="k">$2</span>$3').replace(/^(\.\w+)/,'<span class="s">$1</span>').replace(/"[^"]*"/g,m=>'<span class="v">'+m+'</span>');
const G=(R,C,cols,arr)=>({R,C,cols,areas:arr.map((a,i)=>({n:a[0],r1:a[1],c1:a[2],r2:a[3],c2:a[4],i}))});
const cells=n=>Array.from({length:n},(_,i)=>['k'+(i+1),i/3|0,i%3,i/3|0,i%3]);
const Q=[
{t:'fill',p:'Soru 1: Hedef ızgarayı kuran kodun boşluklarını doldur.',pv:G(1,3,'1fr 1fr 2fr',[['1',0,0,0,0],['2',0,1,0,1],['3',0,2,0,2]]),code:'.container {\n  display: {0};\n  grid-template-columns: {1};\n}',b:[{o:['flex','grid','block'],a:1,c:'display: grid yazılınca kapsayıcının çocukları ızgara düzenine girer.'},{o:['1fr 1fr 2fr','1fr 2fr 1fr','2fr 1fr 1fr'],a:0,c:'Üçüncü kutu diğerlerinin iki katı geniş, yani 1fr 1fr 2fr. Toplam 4 parçanın 2’sini son sütun alır.'}],e:'fr birimi boş alanı oransal paylaştırır. 3 sütun için 3 değer yazılır.'},
{t:'paint',p:'Soru 2: A–G yerleşimini çiz (a ve b iki sütunlu satırlar var).',tg:G(3,3,null,[['a',0,0,0,1],['b',0,2,0,2],['c',1,0,1,0],['d',1,1,1,1],['e',1,2,1,2],['f',2,0,2,0],['g',2,1,2,2]]),e:'Sorudaki gap: 10px hücreler arası boşluktur. div:nth-child(7) yedinci kutuyu (g) seçer. grid-area: 3/2/4/4 → 3. satır ve 2. sütun çizgisinden başlar, 4. satır ve 4. sütun çizgisinde biter.'},
{t:'paint',p:'Soru 3: Büyük 1 numaralı kutuyu doğru yere çiz, diğerleri tek hücre.',tg:G(4,3,null,[['k2',0,0,0,0],['k3',0,1,0,1],['k4',0,2,0,2],['k5',1,0,1,0],['k6',2,0,2,0],['k7',3,0,3,0],['k1',1,1,3,2]]),e:'1 numaralı kutu son çocuktur: div:last-child { grid-area: 2/2/5/4; } ya da grid-column: 2/4; grid-row: 2/5;'},
{t:'paint',p:'Soru 4: header, content, sidebar ve footer düzenini çiz.',tg:G(3,2,'3fr 1fr',[['header',0,0,0,1],['content',1,0,1,0],['sidebar',1,1,1,1],['footer',2,0,2,1]]),e:'Çocuklara kendi adları yazılır: header{grid-area:header} div#content{grid-area:content} div#sidebar{grid-area:sidebar} footer{grid-area:footer}'},
{t:'fill',p:'Soru 5: 3 sütun x 4 satırlık düzeni repeat ile yaz.',pv:G(4,3,null,cells(12)),code:'.kapsayici {\n  display: grid;\n  grid-template-columns: {0};\n  grid-template-rows: {1};\n}',b:[{o:['repeat(3, 100px)','repeat(100px, 3)','repeat(3)'],a:0,c:'repeat(3, 100px) = 100px 100px 100px. Önce tekrar sayısı, sonra ölçü yazılır.'},{o:['repeat(4, 100px)','repeat(100px, 4)','4(100px)'],a:0,c:'Satırlar için de aynı: repeat(4, 100px).'}],e:'12 kutu = 3 sütun x 4 satır. repeat, aynı ölçüyü tekrar tekrar yazmayı kısaltır.'},
{t:'fill',p:'Soru 6: Sıfırlama kodunu tamamla.',code:'{0} {margin:0; padding:0; box-sizing: border-box;}\nbody {height: {1};}',b:[{o:['*','#','body','.all'],a:0,c:'* seçicisi tüm HTML nesnelerini seçer, otomatik boşluklar sıfırlanır.'},{o:['100%','100dvh','auto','100px'],a:1,c:'dvh, mobil tarayıcı çubuklarına göre değişen görünür alan yüksekliğidir.'}],e:'100dvh içeriği görünür alanın yüksekliğine tam oturtur.'},
{t:'fill',p:'Soru 7: div>div{$}*2 Emmet komutunun HTML çıktısını seç.',code:'div>div{$}*2\n→ {0}',b:[{o:['<div><div>1</div><div>2</div></div>','<div>1</div><div>2</div>','<div><div>$</div></div>'],a:0,c:'div>div iç içe yapı kurar, {$} sayaç yazar, *2 iç div’i iki kez tekrarlar.'}],e:'Emmet: > çocuk, {} metin, $ sayaç, *n tekrar.'}
];
const NM=['header','nav','content','sidebar','footer','a','b','c'];
let F={R:3,C:2,areas:G(3,2,null,[['header',0,0,0,1],['content',1,0,1,0],['sidebar',1,1,1,1],['footer',2,0,2,1]]).areas},st={m:'init',R:3,C:2,cols:null,areas:[],tool:'lasso',v:'name',q:0,lock:0,done:{}},T=[];
const nextName=l=>l.find(x=>!st.areas.some(a=>a.n==x))||l[0];
const key=a=>[a.r1,a.c1,a.r2,a.c2].join();
const ga=a=>`${a.r1+1}/${a.c1+1}/${a.r2+2}/${a.c2+2}`;
function areaCap(a){const w=a.c2-a.c1+1,h=a.r2-a.r1+1,sp=[w>1?w+' sütun':'',h>1?h+' satır':''].filter(Boolean).join(', ');return `<b>${a.n}</b>: ${a.r1+1}. satır çizgisinden ${a.r2+2}.ye, ${a.c1+1}. sütun çizgisinden ${a.c2+2}.ye uzanır${sp?' ('+sp+' birleşir)':''}.`}
function gen(areas,R,C,v,cols){const L=[],add=(t,a,cap)=>L.push({t,a:a||[],cap});
add('.kapsayici {',[],'Kapsayıcı: tüm ızgara kuralları burada yazılır.');
add('  display: grid;',[],'display: grid → çocuk nesneler ızgara düzenine girer.');
add(`  grid-template-columns: ${cols||`repeat(${C}, 1fr)`};`,[],`Sütunlar: ${cols||C+' eşit sütun'}. fr, boş alanı oransal paylaştırır.`);
add(`  grid-template-rows: repeat(${R}, 1fr);`,[],`${R} satır tanımlanır. repeat aynı ölçüyü tekrarlar.`);
add('  gap: 8px;',[],'gap: hücreler arasında boşluk bırakır.');
if(v=='name'){add('  grid-template-areas:',[],'Alanlar sözel haritalanır: her tırnak bir satırdır, nokta boş hücredir.');
for(let r=0;r<R;r++){const row=[];for(let c=0;c<C;c++){const a=areas.find(x=>r>=x.r1&&r<=x.r2&&c>=x.c1&&c<=x.c2);row.push(a?a.n:'.')}
add(`    "${row.join(' ')}"${r==R-1?';':''}`,[...new Set(row.filter(x=>x!='.'))],`${r+1}. satır: aynı ad yan yana yazılırsa alan birleşir.`)}
add('}',[],'');areas.forEach(a=>add(`.${a.n} { grid-area: ${a.n}; }`,[a.n],areaCap(a)))}
else{add('}',[],'');areas.forEach(a=>add(`.${a.n} { grid-area: ${ga(a).replace(/\//g,' / ')}; }`,[a.n],areaCap(a)+' Sıra: satır başı / sütun başı / satır sonu / sütun sonu.'))}
return L}
function render(){const g=$('#grid');g.style.gridTemplateColumns=st.cols||`repeat(${st.C},1fr)`;g.style.gridTemplateRows=`repeat(${st.R},1fr)`;
let h='';for(let r=1;r<=st.R;r++)for(let c=1;c<=st.C;c++)h+=`<i class="c" style="grid-area:${r}/${c}"></i>`;
st.areas.forEach(a=>{h+=`<b class="a${a.f?' pop':''}${a.p?' pulse':''}${a.x?' bad':''}" style="grid-area:${ga(a)};--c:${PAL[a.i%8]}">${esc(a.n)}</b>`;a.f=a.p=a.x=0});
g.innerHTML=h+'<u id="sel" hidden></u>'}
function showCode(L,anim){$('#code').innerHTML=L.map(l=>`<div class="l${anim?' h':''}">${hl(l.t)}</div>`).join('')}
function capFree(){$('#cap').innerHTML=st.areas.length?st.areas.map(a=>`<p>${areaCap(a)}</p>`).join(''):'<p>Lasso ile hücreler üzerinde sürükleyerek alan çiz. Silgi ile alanları sil.</p>'}
function refresh(){render();showCode(gen(st.areas,st.R,st.C,st.v,st.cols),0);if(st.m=='free')capFree()}
function stop(){T.forEach(clearTimeout);T=[];st.lock=0}
function play(full,extra){stop();st.lock=1;st.areas=[];render();const L=gen(full,st.R,st.C,st.v,st.cols);showCode(L,1);
L.forEach((l,i)=>T.push(setTimeout(()=>{const e=$('#code').children[i];e.classList.remove('h');$('#code').scrollTop=e.offsetTop-40;$('#cap').innerHTML=l.cap?`<p>${l.cap}</p>`:'';
l.a.forEach(n=>{const x=st.areas.find(a=>a.n==n);if(x)x.p=1;else{const f=full.find(a=>a.n==n);if(f)st.areas.push({...f,f:1})}});render()},700*(i+1))));
T.push(setTimeout(()=>{st.lock=0;if(extra)$('#cap').innerHTML+=`<p class="ex">${extra}</p>`},700*(L.length+1)))}
function playFill(q){st.lock=1;[...document.querySelectorAll('#fill select')].forEach((s,k,all)=>{T.push(setTimeout(()=>{const b=q.b[s.dataset.i],sp=document.createElement('span');sp.className='ans';sp.textContent=b.o[b.a];s.replaceWith(sp);$('#cap').innerHTML=`<p>${b.c}</p>`},800*(k+1)))});
T.push(setTimeout(()=>{st.lock=0;$('#cap').innerHTML+=`<p class="ex">${q.e}</p>`},800*(document.querySelectorAll('#fill select').length+1)))}
function mini(t){return `<div class="mini" style="grid-template:repeat(${t.R},1fr)/${t.cols||`repeat(${t.C},1fr)`}">${t.areas.map(a=>`<b style="grid-area:${ga(a)};background:${PAL[a.i%8]}">${a.n}</b>`).join('')}</div>`}
function loadQ(i){stop();st.q=i;const q=Q[i],paint=q.t=='paint',tg=q.tg||q.pv;
document.querySelectorAll('#chips button').forEach((b,k)=>b.classList.toggle('on',k==i));
$('#prompt').textContent=q.p;$('#thumb').innerHTML=tg?mini(tg):'';$('#thumb').hidden=!tg;
$('#grid').hidden=!paint;$('#fill').hidden=paint;$('#code').hidden=!paint;$('#vw').hidden=!paint;document.querySelectorAll('.po').forEach(b=>b.hidden=!paint);
if(paint){Object.assign(st,{R:q.tg.R,C:q.tg.C,cols:q.tg.cols,areas:[]});refresh();$('#cap').innerHTML='<p>Hedefe bakarak lasso ile sürükle, sonra Kontrol et.</p>'}
else{$('#fill').innerHTML='<pre class="fc">'+q.code.split(/\{(\d)\}/).map((s,k)=>k%2?`<select data-i="${s}"><option value="">?</option>${q.b[s].o.map((o,j)=>`<option value="${j}">${esc(o)}</option>`).join('')}</select>`:esc(s)).join('')+'</pre>';$('#cap').innerHTML='<p>Boşlukları seç, sonra Kontrol et.</p>'}}
function setMode(m){stop();if(st.m=='free')F={R:st.R,C:st.C,areas:st.areas};st.m=m;
document.querySelectorAll('#modes button').forEach(b=>b.classList.toggle('on',b.dataset.m==m));
$('#qbar').hidden=m=='free';$('#t2').hidden=m!='free';$('#chk').hidden=m=='free';
if(m=='free'){Object.assign(st,{R:F.R,C:F.C,cols:null,areas:F.areas});$('#grid').hidden=0;$('#fill').hidden=1;$('#code').hidden=0;$('#vw').hidden=0;document.querySelectorAll('.po').forEach(b=>b.hidden=0);$('#rv').textContent=st.R;$('#cv').textContent=st.C;refresh()}else loadQ(st.q)}
const g=$('#grid');let s0=null;
const cell=e=>{const r=g.getBoundingClientRect(),f=(v,n)=>Math.min(n-1,Math.max(0,Math.floor(v*n)));return[f((e.clientY-r.top)/r.height,st.R),f((e.clientX-r.left)/r.width,st.C)]};
const selBox=(a,b)=>{const u=$('#sel');u.hidden=0;u.className=st.tool;u.style.gridArea=`${Math.min(a[0],b[0])+1}/${Math.min(a[1],b[1])+1}/${Math.max(a[0],b[0])+2}/${Math.max(a[1],b[1])+2}`};
g.onpointerdown=e=>{if(st.lock)return;s0=cell(e);g.setPointerCapture(e.pointerId);selBox(s0,s0)};
g.onpointermove=e=>{if(s0)selBox(s0,cell(e))};
g.onpointercancel=()=>{s0=null;render()};
g.onpointerup=e=>{if(!s0)return;const a=s0,b=cell(e);s0=null;
const r1=Math.min(a[0],b[0]),r2=Math.max(a[0],b[0]),c1=Math.min(a[1],b[1]),c2=Math.max(a[1],b[1]),hit=x=>!(x.r2<r1||x.r1>r2||x.c2<c1||x.c1>c2);
if(st.tool=='eraser')st.areas=st.areas.filter(x=>!hit(x));
else{const n=st.m=='free'?$('#nm').value:nextName('abcdefgh'.split(''));st.areas=st.areas.filter(x=>!hit(x)&&x.n!=n);st.areas.push({n,r1,c1,r2,c2,i:st.n=(st.n||10)+1,f:1});if(st.m=='free')$('#nm').value=nextName(NM)}
refresh()};
document.querySelectorAll('[data-t]').forEach(b=>b.onclick=()=>{st.tool=b.dataset.t;document.querySelectorAll('[data-t]').forEach(x=>x.classList.toggle('on',x==b))});
document.querySelectorAll('[data-v]').forEach(b=>b.onclick=()=>{st.v=b.dataset.v;document.querySelectorAll('[data-v]').forEach(x=>x.classList.toggle('on',x==b));if(!st.lock)refresh()});
document.querySelectorAll('[data-m]').forEach(b=>b.onclick=()=>setMode(b.dataset.m));
$('#clr').onclick=()=>{if(st.lock)return;st.areas=[];refresh()};
$('#play').onclick=()=>{if(st.m=='free'){if(st.areas.length)play(st.areas.map(a=>({...a})))}else{const q=Q[st.q];play(q.tg.areas.map(a=>({...a})),q.e)}};
const step=(d,k)=>{st[k]=Math.min(6,Math.max(1,st[k]+d));st.areas=st.areas.filter(a=>a.r2<st.R&&a.c2<st.C);$('#rv').textContent=st.R;$('#cv').textContent=st.C;refresh()};
$('#rm').onclick=()=>step(-1,'R');$('#rp').onclick=()=>step(1,'R');$('#cm').onclick=()=>step(-1,'C');$('#cp').onclick=()=>step(1,'C');
$('#chk').onclick=()=>{if(st.lock)return;const q=Q[st.q];let ok,msg;
if(q.t=='paint'){const T2=new Set(q.tg.areas.map(key)),bad=st.areas.filter(a=>!T2.has(key(a)));bad.forEach(a=>a.x=1);const hit=st.areas.length-bad.length;ok=!bad.length&&hit==T2.size;render();
msg=ok?'Doğru! Şimdi çözümü adım adım oynatıyorum.':`${bad.length} alan hatalı, ${T2.size-hit} alan eksik. Çözümü oynatıyorum.`;
$('#cap').innerHTML=`<p class="${ok?'good':'no'}">${msg}</p>`;T.push(setTimeout(()=>play(q.tg.areas.map(a=>({...a})),q.e),1300))}
else{ok=1;document.querySelectorAll('#fill select').forEach(s=>{const g2=s.value!==''&&+s.value===q.b[s.dataset.i].a;ok=ok&&g2;s.className=g2?'ok':'no'});
$('#cap').innerHTML=`<p class="${ok?'good':'no'}">${ok?'Doğru! Açıklamayı oynatıyorum.':'Hatalı seçim var. Doğru cevapları açıklıyorum.'}</p>`;T.push(setTimeout(()=>playFill(q),1200))}
if(ok){st.done[st.q]=1;$('#chips').children[st.q].classList.add('done')}};
$('#nm').innerHTML=NM.map(n=>`<option>${n}</option>`).join('');
$('#chips').innerHTML=Q.map((_,i)=>`<button data-q="${i}">${i+1}</button>`).join('');
document.querySelectorAll('#chips button').forEach(b=>b.onclick=()=>loadQ(+b.dataset.q));
setMode('free');
</script>
</body>
</html>
